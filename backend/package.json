{
  "name": "doctors-appointment-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for a doctors appointment application",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "seed": "node scripts/seed.js",
    "seed:admin": "node scripts/seed-admin.js"
  },
  "jest": {
